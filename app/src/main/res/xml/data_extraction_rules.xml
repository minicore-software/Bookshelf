<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules file. The database path must match
   DatabaseModule.DATABASE_NAME ("bookshelf.db"); the -wal suffix is included
   because Room uses WAL journal mode on API 29+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="bookshelf.db"/>
        <include domain="database" path="bookshelf.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bookshelf.db"/>
        <include domain="database" path="bookshelf.db-wal"/>
        <!-- ADR-003: cover images move with a same-device transfer, but never to the cloud
             (see <cloud-backup> above, which has no "file" include) and never into the
             pre-API-31 <full-backup-content> below - a cloud restore falls back to the
             id-derived colour placeholder (BookCover), by design. -->
        <include domain="file" path="covers/"/>
    </device-transfer>
</data-extraction-rules>
